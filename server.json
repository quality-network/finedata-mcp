{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.quality-network/finedata-mcp",
  "title": "FineData",
  "description": "FineData web scraping MCP — JavaScript rendering, captcha solving, markdown for AI agents",
  "version": "0.3.0",
  "websiteUrl": "https://finedata.ai/mcp/",
  "repository": {
    "url": "https://github.com/quality-network/finedata-mcp",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "finedata-mcp",
      "version": "0.3.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "FINEDATA_API_KEY",
          "description": "FineData API key (fd_…)",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "FINEDATA_API_URL",
          "description": "API base URL",
          "isRequired": false,
          "default": "https://api.finedata.ai"
        }
      ]
    },
    {
      "registryType": "npm",
      "identifier": "@finedata/mcp-server",
      "version": "0.3.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "FINEDATA_API_KEY",
          "description": "FineData API key (fd_…)",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.finedata.ai/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer fd_… API key. Optional: an OAuth 2.1 client discovers the flow from the 401 challenge instead of being asked for a key up front.",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ]
}
